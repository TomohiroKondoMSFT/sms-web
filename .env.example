# 環境変数サンプル（.env.example）
# このファイルをコピーして .env を作成し、実際の値を設定してください
# .env は .gitignore により Git 管理外です（絶対にコミットしないこと）

# GitHub Personal Access Token
# 取得方法: GitHub > Settings > Developer settings > Personal access tokens
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_REPLACE_WITH_YOUR_TOKEN

# Azure Subscription ID
# 取得方法: az account show --query id -o tsv
AZURE_SUBSCRIPTION_ID=REPLACE_WITH_YOUR_SUBSCRIPTION_ID
